DATABASE_URL=postgresql://sterlyn:change-me@localhost:5432/sterlyn
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sterlyn
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
STAFF_EMAIL=
CLAMSCAN_PATH=clamscan
# Set true only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=false
# Set owner credentials privately when running setup:owner; never commit them.
OWNER_EMAIL=
OWNER_PASSWORD=
PUBLIC_LAUNCH=false
# Isolated processing requires the Docker processor and scanner services.
MEDIA_SPOOL=/spool
CLAMAV_HOST=antivirus
# Enable after storage, fresh scanner definitions and worker heartbeat are configured.
READINESS_REQUIRE_MEDIA=false

# Browser-reachable HTTPS S3 API endpoint for signed uploads; internal S3_ENDPOINT remains server-only.
S3_PUBLIC_ENDPOINT=

# Shared web/worker key: 32 random bytes represented by exactly 64 hexadecimal characters.
# Generate privately; changing it invalidates decryption of existing tracking links.
TRACKING_ENCRYPTION_KEY=
