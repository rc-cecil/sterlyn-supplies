# Build the official pinned MinIO source when public binary registries are unavailable.
FROM golang:1.24-bookworm AS build
ARG MINIO_RELEASE=RELEASE.2025-04-22T22-12-26Z
WORKDIR /source
RUN curl -fsSL "https://github.com/minio/minio/archive/refs/tags/${MINIO_RELEASE}.tar.gz" | tar -xz --strip-components=1
RUN CGO_ENABLED=0 go build -trimpath -o /minio .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /minio /usr/local/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
