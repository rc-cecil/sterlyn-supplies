{
  "name": "sterlyn-supplies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo:config": "tsx scripts/demo-config.ts",
    "db:verify-restore": "tsx scripts/verify-restore.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "setup:owner": "tsx scripts/setup-owner.ts",
    "worker": "tsx scripts/worker.ts",
    "media:studio": "remotion studio media/index.ts --no-open",
    "media:render": "remotion render media/index.ts SterlynLogo public/video/sterlyn-logo-v3.mp4",
    "walkthrough:serve": "node scripts/serve-walkthrough.mjs",
    "email:verify": "tsx scripts/verify-email.ts",
    "db:production:check": "tsx scripts/production-db.ts",
    "db:production:migrate": "tsx scripts/production-db.ts --migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@remotion/cli": "4.0.534",
    "@remotion/three": "4.0.534",
    "better-auth": "^1.4.0",
    "dotenv": "^17.2.0",
    "gsap": "^3.14.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.6",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "remotion": "4.0.534",
    "sharp": "0.35.5",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
