generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  role String @default("customer")
  suspended Boolean @default(false)
  twoFactorEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  twoFactor TwoFactor?
  addresses Address[]
  carts Cart[]
  orders Order[]
  projects DesignProject[]
  wishlists Wishlist[]
  @@map("user")
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
  @@map("session")
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("account")
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}
model TwoFactor {
  id String @id
  secret String
  backupCodes String
  verified Boolean @default(false)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("twoFactor")
}
model Address {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  line1 String
  city String
  region String
  phone String
}
model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  image String
  products Product[]
  coverAssetId String?
  coverAsset MediaAsset? @relation(fields:[coverAssetId],references:[id],onDelete:Restrict)
}
model ProductPicture {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  assetId String?
  asset MediaAsset? @relation(fields:[assetId],references:[id],onDelete:Restrict)
  source String
  alt String
  position Int
  @@unique([productId,position])
  @@index([assetId])
}
model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  style String
  material String
  image String
  gallery String[]
  status String @default("draft")
  illustrative Boolean @default(true)
  featured Boolean @default(false)
  trackStock Boolean @default(false)
  pictures ProductPicture[]
  specifications Json @default("{}")
  seoTitle String?
  seoDescription String?
  publishAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants Variant[]
  wishlists Wishlist[]
  reviews Review[]
  @@index([status,categoryId,style])
}
model Variant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  sku String @unique
  name String
  color String
  image String?
  price Int?
  currency String @default("GHS")
  verified Boolean @default(false)
  stock Int @default(0)
  lowStock Int @default(3)
  cartItems CartItem[]
  orderItems OrderItem[]
  movements StockMovement[]
  reservations Reservation[]
}
model StockMovement {
  id String @id @default(cuid())
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  quantity Int
  reason String
  actorId String
  createdAt DateTime @default(now())
  @@index([variantId,createdAt])
}
model Cart {
  id String @id @default(cuid())
  token String @unique
  userId String?
  user User? @relation(fields:[userId],references:[id])
  items CartItem[]
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model CartItem {
  id String @id @default(cuid())
  cartId String
  cart Cart @relation(fields:[cartId],references:[id],onDelete:Cascade)
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  quantity Int
  @@unique([cartId,variantId])
}
model Wishlist {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  productId String
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  @@unique([userId,productId])
}
model Customer {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  userId String? @unique
  verifiedBy String
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enquiries Quote[]
  orders Order[]
}
model Order {
  reference String? @unique @default(dbgenerated("('SSL-'::text || lpad((nextval('order_reference_seq'::regclass))::text, GREATEST(6, length((currval('order_reference_seq'::regclass))::text)), '0'::text))"))
  customerId String?
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:Restrict)
  phone String?
  assignedTo String?
  expectedDelivery DateTime?
  resumeStatus String?
  version Int @default(1)
  trackingHash String? @unique
  trackingCipher String?
  trackingRevokedAt DateTime?
  trackingExpiresAt DateTime?
  invoices Invoice[]
  sourceQuoteId String? @unique
  sourceQuote Quote? @relation(fields:[sourceQuoteId],references:[id])
  quoteSnapshot Json?
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId],references:[id])
  email String
  name String
  address Json
  accessHash String
  status String @default("pending_payment")
  currency String @default("GHS")
  subtotal Int
  tax Int
  shipping Int
  discount Int @default(0)
  total Int
  tracking String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payments Payment[]
  refunds Refund[]
  events OrderEvent[]
  reservations Reservation[]
  @@index([status,createdAt])
  @@index([customerId])
  @@index([userId])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  variantId String?
  variant Variant? @relation(fields:[variantId],references:[id],onDelete:Restrict)
  kind String @default("product")
  snapshot Json?
  name String
  sku String
  quantity Int
  price Int?
}
model Reservation {
  id String @id @default(cuid())
  variantId String
  variant Variant @relation(fields:[variantId],references:[id])
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  quantity Int
  expiresAt DateTime
  released Boolean @default(false)
  @@index([expiresAt,released])
}
model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  reference String @unique
  status String @default("pending")
  provider String @default("manual")
  currency String?
  confirmedBy String?
  confirmedAt DateTime?
  externalReference String?
  method String?
  reversalOf String? @unique
  originalReceipt Payment? @relation("ReceiptReversal",fields:[reversalOf],references:[id],onDelete:Restrict)
  reversal Payment? @relation("ReceiptReversal")
  reason String?
  requestKey String? @unique
  amount Int
  authorizationUrl String?
  createdAt DateTime @default(now())
}
model WebhookEvent {
  id String @id
  provider String
  status String
  createdAt DateTime @default(now())
}
model Refund {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  amount Int
  reason String
  status String @default("pending")
  providerId String? @unique
  createdAt DateTime @default(now())
}
model EnquiryEvent {
  id String @id @default(cuid())
  quoteId String
  quote Quote @relation(fields:[quoteId],references:[id],onDelete:Restrict)
  previousStatus String?
  status String
  actorId String
  note String @default("")
  createdAt DateTime @default(now())
  @@index([quoteId,createdAt])
}
model OrderEvent {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id])
  status String
  previousStatus String?
  publicNote String?
  note String
  actorId String
  createdAt DateTime @default(now())
  @@index([orderId,createdAt])
}
model Quote {
  requestKey String? @unique
  requestHash String?
  customerId String?
  customer Customer? @relation(fields:[customerId],references:[id],onDelete:Restrict)
  version Int @default(1)
  history EnquiryEvent[]
  reference String @unique @default(dbgenerated("('SQ-'::text || lpad((nextval('quote_reference_seq'::regclass))::text, GREATEST(6, length((currval('quote_reference_seq'::regclass))::text)), '0'::text))"))
  customerSummary String?
  validUntil DateTime?
  order Order?
  id String @id @default(cuid())
  name String
  email String
  phone String?
  notes String
  status String @default("new")
  assignedTo String?
  estimate Int?
  staffNotes String?
  scene Json?
  items Json
  userId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
  @@index([customerId])
}
model DesignProject {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  name String
  scene Json
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model MediaAsset {
  productPictures ProductPicture[]
  categoryCovers Category[]
  id String @id @default(cuid())
  name String
  key String @unique
  mime String
  size Int
  alt String
  status String @default("quarantined")
  placement String?
  posterKey String?
  outputKey String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
}
model MediaPublication {
  id String @id @default(cuid())
  placement String
  assetId String
  actorId String
  createdAt DateTime @default(now())
  @@index([placement,createdAt])
}
model VideoJob {
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  heartbeatAt DateTime?
  @@index([kind,status,leaseUntil])
  id String @id @default(cuid())
  kind String
  status String @default("queued")
  prompt String?
  model String?
  operation String?
  assetId String?
  input Json @default("{}")
  error String?
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CmsPage {
  revisions CmsRevision[]
  id String @id @default(cuid())
  slug String @unique
  title String
  body String
  status String @default("draft")
  image String?
  updatedAt DateTime @updatedAt
}
model Promotion {
  id String @id @default(cuid())
  code String @unique
  percent Int
  active Boolean @default(false)
  startsAt DateTime @default(now())
  expiresAt DateTime
  limit Int
  used Int @default(0)
}
model SupportTicket {
  id String @id @default(cuid())
  name String
  email String
  subject String
  message String
  status String @default("open")
  notes String?
  createdAt DateTime @default(now())
}
model Review {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields:[productId],references:[id])
  name String
  rating Int
  body String
  status String @default("pending")
  createdAt DateTime @default(now())
}
model Notification {
  html String?
  dedupeKey String? @unique
  templateData Json?
  leaseToken String?
  leaseUntil DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id String @id @default(cuid())
  recipient String
  subject String
  body String
  status String @default("queued")
  error String?
  createdAt DateTime @default(now())
  @@index([status,nextAttemptAt])
}
model Newsletter {
  id String @id @default(cuid())
  email String @unique
  consentAt DateTime @default(now())
}
model AnalyticsEvent {
  id String @id @default(cuid())
  event String
  path String
  createdAt DateTime @default(now())
  @@index([createdAt,event])
}
model InsightQuery {
  id String @id @default(cuid())
  actorId String
  question String
  spec Json
  createdAt DateTime @default(now())
}
model Setting {
  key String @id
  value Json
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  role String
  action String
  entity String
  entityId String
  summary Json
  correlationId String
  createdAt DateTime @default(now())
  @@index([createdAt,entity,actorId])
}
model RateLimit {
  key String @id
  count Int
  resetAt DateTime
}

model StaffInvitation {
  id String @id @default(cuid())
  email String
  role String
  tokenHash String @unique
  invitedBy String
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([email,expiresAt])
}

model CmsRevision {
 id String @id @default(cuid())
 pageId String
 page CmsPage @relation(fields:[pageId],references:[id],onDelete:Restrict)
 title String
 body String
 actorId String
 status String
 createdAt DateTime @default(now())
 @@index([pageId,createdAt])
}

model UploadIntent {
 id String @id @default(cuid())
 actorId String
 key String @unique
 mime String
 name String
 alt String
 size Int
 expiresAt DateTime
 assetId String? @unique
 createdAt DateTime @default(now())
 @@index([expiresAt,assetId])
}

model Invoice {
 order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
 id String @id @default(cuid())
 orderId String
 status String @default("draft")
 number String? @unique
 snapshot Json
 actorId String
 issuedAt DateTime?
 voidedAt DateTime?
 voidReason String?
 createdAt DateTime @default(now())
 @@index([orderId,status])
}
model InvoiceCounter {
 year Int @id
 value Int @default(0)
}
model PrivacyRequest {
 id String @id @default(cuid())
 userId String
 status String @default("requested")
 reason String?
 reviewedBy String?
 completedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId,status])
}

model PublicationSchedule {
 id String @id @default(cuid())
 target String
 targetId String
 placement String?
 publishAt DateTime
 actorId String
 status String @default("scheduled")
 error String?
 createdAt DateTime @default(now())
 @@index([status,publishAt])
}
